{
  "name": "x-tools",
  "version": "0.0.0",
  "description": "Unofficial, read-only X tools for coding agents: search, threads, profiles, media and post checks.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/x-tools#readme",
  "repository": "https://github.com/craft-agent/x-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "x-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "X_TOOLS_TOOLSETS",
        "X_TOOLS_READ_ONLY",
        "X_TOOLS_TOOLS",
        "X_TOOLS_EXCLUDE_TOOLS",
        "X_TOOLS_CONFIRM",
        "X_TOOLS_UNATTENDED",
        "X_TOOLS_GRANTS_DIR",
        "X_TOOLS_STATE_DIR",
        "X_TOOLS_GRANT_KEY",
        "XDG_STATE_HOME"
      ]
    }
  }
}
